#!/usr/bin/with-contenv bash
# shellcheck shell=bash

function __fixuser {

    echo "以PUID=${PUID}，PGID=${PGID}的身份启动程序..."

    # 更改 nexus userid 和 groupid
    groupmod -o -g "$PGID" nexus
    usermod -o -u "$PUID" nexus

    # 创建目录、权限设置
    # WORKDIR 在构建时已用 --chown=nexus:nexus COPY，此处只处理运行时挂载卷和特殊文件
    chown -R nexus:nexus "${HOME}" /config /etc/hosts 2>/dev/null || true

    # nginx 以 nexus 身份运行（PUID/PGID 非 0 时非 root），需保证其临时/日志/pid 目录可写，
    # 否则会报 mkdir() "/var/lib/nginx/body" failed (13: Permission denied)
    mkdir -p /var/lib/nginx/body /var/lib/nginx/proxy /var/lib/nginx/fastcgi \
        /var/lib/nginx/uwsgi /var/lib/nginx/scgi /var/log/nginx /run/nginx
    chown -R nexus:nexus /var/lib/nginx /var/log/nginx /run/nginx

}

__fixuser 2>&1 | sed "s#^#cont-init: info: $(realpath $0): &#g"