{
  "manifest_version": "1.0",
  "id": "libraryscraper",
  "name": "媒体库刮削",
  "version": "1.2",
  "author": "linyuan0213",
  "author_url": "https://github.com/linyuan0213",
  "description": "定时对媒体库进行刮削，补齐缺失元数据和图片。",
  "category": "media",
  "tags": ["刮削", "元数据"],
  "icon": "lucide:file-search",
  "color": "#f97316",
  "min_app_version": "3.0.0",
  "backend": {
    "entry": "backend.plugin:LibraryScraperPlugin",
    "api_prefix": "/api/plugin/libraryscraper",
    "permissions": [],
    "hooks": [
      "plugin.config_changed",
      "media.scraped"
    ],
    "supports_run": true
  },
  "frontend": {
    "routes": [],
    "settings": {
      "component": "SettingsPage",
      "fields": [
        {
          "key": "cron",
          "type": "cron",
          "label": "刮削周期",
          "default": "0 8 * * *",
          "placeholder": "0 8 * * *",
          "help": "支持5位cron表达式；刮削时间根据媒体库文件数量及网络状况而定"
        },
        {
          "key": "mode",
          "type": "select",
          "label": "刮削模式",
          "default": "repair",
          "options": [
            {"label": "补齐缺失元数据（推荐）", "value": "repair"},
            {"label": "仅处理完全未刮削的文件", "value": "missing"},
            {"label": "全量刮削（覆盖元数据和图片）", "value": "force_all"}
          ],
          "help": "补齐模式只处理缺海报/横版占位/无演员 NFO 的目录；全量模式会覆盖已有元数据和图片"
        },
        {
          "key": "backup_before_repair",
          "type": "boolean",
          "label": "写入前备份",
          "default": true,
          "help": "备份 poster/thumb/fanart/NFO/.watermark 到独立目录，备份失败时跳过该目录"
        },
        {
          "key": "backup_path",
          "type": "input",
          "label": "备份目录",
          "default": "",
          "placeholder": "留空使用 data/plugin_backups/libraryscraper",
          "help": "每次运行按时间戳和 pid 建立独立子目录"
        },
        {
          "key": "batch_limit",
          "type": "number",
          "label": "单次批量上限",
          "default": 0,
          "help": "0 表示不限制；建议首次修复先设为 5-10 条验证"
        },
        {
          "key": "only_codes",
          "type": "input",
          "label": "仅处理番号",
          "default": "",
          "placeholder": "IPX-247,DV-1622,TC-268",
          "help": "逗号分隔；目录名包含任一番号时才处理，用于小范围验证"
        },
        {
          "key": "scraper_path",
          "type": "textarea",
          "label": "刮削路径",
          "default": "",
          "placeholder": "每行一个路径",
          "help": "需要刮削的媒体库路径"
        },
        {
          "key": "exclude_path",
          "type": "input",
          "label": "排除路径",
          "default": "",
          "placeholder": "多个路径用,分割",
          "help": "需要排除的媒体库路径"
        }
      ]
    },
    "slots": []
  }
}
